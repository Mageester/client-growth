{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "client-growth",
  "compatibility_date": "2026-08-31",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./workers/app.ts",
  // Pinned so `pnpm dev`, .dev.vars' BETTER_AUTH_URL, and .claude/launch.json
  // always agree. A drifting dev port breaks Better Auth's trusted-origin check.
  "dev": {
    "port": 8788
  },
  "assets": {
    "directory": "./build/client",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "invocation_logs": false
    }
  },
  // Recurring monitoring. ONE trigger for the whole product — the tick asks the
  // database which monitored clients are due and processes a bounded batch, so
  // the scheduler's frequency is independent of any client's cadence. Hourly is
  // ample for a weekly cadence and keeps each tick's work small.
  // Locally: `wrangler dev --test-scheduled`, then POST /__scheduled.
  "triggers": {
    "crons": ["0 * * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "client-growth-dev",
      "database_id": "local-dev-placeholder",
      "migrations_dir": "migrations"
    }
  ],
  "env": {
    "production": {
      "name": "client-growth-production",
      "workers_dev": true,
      "preview_urls": false,
      // Declared explicitly rather than inherited: what runs unattended against
      // production data should be readable in the production block itself.
      "triggers": {
        "crons": ["0 * * * *"]
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "client-growth-production",
          "database_id": "fcb0af15-ccef-446f-be77-01aafa5f5e50",
          "migrations_dir": "migrations"
        }
      ],
      "vars": {
        "AI_PROVIDER": "deepseek",
        "DEEPSEEK_BASE_URL": "https://api.deepseek.com",
        "DEEPSEEK_MODEL": "deepseek-chat",
        "MAX_AI_CALLS_PER_RUN": "10",
        // Hard ceiling per scheduled tick. With MAX_AI_CALLS_PER_RUN that caps
        // one tick at 30 evaluator calls, whatever the portfolio looks like.
        "MONITORING_MAX_CLIENTS_PER_RUN": "3",
        "BETTER_AUTH_URL": "https://client-growth-production.aidan-magee2.workers.dev",
        "RESEND_FROM_EMAIL": "Client Growth <noreply@getaxiom.ca>"
      },
      "secrets": {
        "required": ["BETTER_AUTH_SECRET", "RESEND_API_KEY", "DEEPSEEK_API_KEY"]
      },
      "observability": {
        "enabled": true,
        "logs": {
          "invocation_logs": false
        }
      }
    }
  },
  "vars": {
    "AI_PROVIDER": "mock",
    "MAX_AI_CALLS_PER_RUN": "10"
  }
}
