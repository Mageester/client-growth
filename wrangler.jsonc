{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "client-growth",
  "compatibility_date": "2026-08-31",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./workers/app.ts",
  // Pinned so `pnpm dev`, .dev.vars' BETTER_AUTH_URL, and .claude/launch.json
  // always agree. A drifting dev port breaks Better Auth's trusted-origin check.
  "dev": {
    "port": 8788
  },
  "assets": {
    "directory": "./build/client",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "invocation_logs": false
    }
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "client-growth-dev",
      "database_id": "local-dev-placeholder",
      "migrations_dir": "migrations"
    }
  ],
  "env": {
    "production": {
      "name": "client-growth-production",
      "workers_dev": true,
      "preview_urls": false,
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "client-growth-production",
          "database_id": "fcb0af15-ccef-446f-be77-01aafa5f5e50",
          "migrations_dir": "migrations"
        }
      ],
      "vars": {
        "AI_PROVIDER": "mock",
        "DEEPSEEK_BASE_URL": "https://api.deepseek.com",
        "DEEPSEEK_MODEL": "deepseek-chat",
        "MAX_AI_CALLS_PER_RUN": "10",
        "BETTER_AUTH_URL": "https://client-growth-production.aidan-magee2.workers.dev",
        "RESEND_FROM_EMAIL": "Client Growth <noreply@getaxiom.ca>"
      },
      "secrets": {
        "required": ["BETTER_AUTH_SECRET", "RESEND_API_KEY"]
      },
      "observability": {
        "enabled": true,
        "logs": {
          "invocation_logs": false
        }
      }
    }
  },
  "vars": {
    "AI_PROVIDER": "mock",
    "MAX_AI_CALLS_PER_RUN": "10"
  }
}
