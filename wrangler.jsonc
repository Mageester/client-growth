{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "client-growth",
  "compatibility_date": "2026-08-31",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./workers/app.ts",
  // Pinned so `pnpm dev`, .dev.vars' BETTER_AUTH_URL, and .claude/launch.json
  // always agree. A drifting dev port breaks Better Auth's trusted-origin check.
  "dev": {
    "port": 8788
  },
  "assets": {
    "directory": "./build/client",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "invocation_logs": false
    }
  },
  // Two unattended schedules. "0 * * * *" is recurring monitoring — the tick
  // asks the database which monitored clients are due and processes a bounded
  // batch, so the scheduler's frequency is independent of any client's cadence.
  // "0 13 * * *" is the MONITOR weekly digest tick; it runs daily and emails
  // only the workspaces whose weekly digest has come due, so it is kept off the
  // hourly scan path that spends on the evaluator. scheduled() branches on which
  // cron fired. Locally: `wrangler dev --test-scheduled`, then POST /__scheduled.
  "triggers": {
    "crons": ["0 * * * *", "0 13 * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "client-growth-dev",
      "database_id": "local-dev-placeholder",
      "migrations_dir": "migrations"
    }
  ],
  "env": {
    "production": {
      "name": "client-growth-production",
      "workers_dev": true,
      "preview_urls": false,
      // Declared explicitly rather than inherited: what runs unattended against
      // production data should be readable in the production block itself. Hourly
      // recurring monitoring plus the daily MONITOR digest tick.
      "triggers": {
        "crons": ["0 * * * *", "0 13 * * *"]
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "client-growth-production",
          "database_id": "fcb0af15-ccef-446f-be77-01aafa5f5e50",
          "migrations_dir": "migrations"
        }
      ],
      "vars": {
        "AI_PROVIDER": "deepseek",
        "DEEPSEEK_BASE_URL": "https://api.deepseek.com",
        "DEEPSEEK_MODEL": "deepseek-chat",
        "MAX_AI_CALLS_PER_RUN": "10",
        // Hard ceiling per scheduled tick. With MAX_AI_CALLS_PER_RUN that caps
        // one tick at 30 evaluator calls, whatever the portfolio looks like.
        "MONITORING_MAX_CLIENTS_PER_RUN": "3",
        // The ceiling on the operator's own bill, across EVERY workspace. The
        // per-workspace cap of 50 bounds one tenant and says nothing about how
        // many tenants exist, so without this the worst case is unbounded.
        // 200 analyses x 10 evaluator calls = 2,000 paid calls in the worst day.
        // Raise it as a decision; never discover it from an invoice.
        "ANALYSIS_PLATFORM_DAILY_LIMIT": "200",
        // Who may create a workspace. "invite" while there is no billing:
        // self-serve signup plus metered paid work plus no way to charge is a
        // bill with strangers' names on it. Delete this the day billing lands.
        // The allowlist admits named addresses or whole domains; an owner's
        // team invitation admits its recipient without touching this list.
        "SIGNUP_MODE": "invite",
        "SIGNUP_ALLOWLIST": "",
        // Who has the paid MONITOR feature (recurring scans + weekly digests).
        // "off" until it is sold: it fails closed in code too, so an env that
        // forgot to say grants it to nobody. Move a workspace onto MONITOR by
        // switching to "allowlist" and naming the owner's address or @domain in
        // MONITOR_ALLOWLIST. Delete this the day billing enforces the tier.
        "MONITOR_ENTITLEMENT_MODE": "off",
        "MONITOR_ALLOWLIST": "",
        // The canonical public origin, and the ONE origin Better Auth trusts —
        // it is never derived from a request's Host or Origin header (see
        // getTrustedAuthBaseURL). orbit.getaxiom.ca now fronts this Worker, and
        // while this still named the workers.dev hostname every sign-in there
        // was rejected with INVALID_ORIGIN. Consequence of pointing it here:
        // the workers.dev URL still serves pages but can no longer sign anyone
        // in, so it is a preview address, not a way into the product.
        "BETTER_AUTH_URL": "https://orbit.getaxiom.ca",
        "RESEND_FROM_EMAIL": "Axiom Orbit <noreply@getaxiom.ca>"
      },
      "secrets": {
        "required": ["BETTER_AUTH_SECRET", "RESEND_API_KEY", "DEEPSEEK_API_KEY"]
      },
      "observability": {
        "enabled": true,
        "logs": {
          "invocation_logs": false
        }
      }
    }
  },
  "vars": {
    "AI_PROVIDER": "mock",
    "MAX_AI_CALLS_PER_RUN": "10"
  }
}
