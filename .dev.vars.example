# Copy to `.dev.vars` (git-ignored) for local Worker runs. NEVER commit the real file.

# --- Authentication (required) ---
# 32+ random chars. Generate: `openssl rand -base64 32`
BETTER_AUTH_SECRET=dev-only-change-me-to-32-plus-random-characters
# Explicit, trusted base URL. Local dev = the wrangler dev origin.
BETTER_AUTH_URL=http://localhost:8788

# --- Password-reset email (required for an external pilot) ---
# RESEND_API_KEY=re_...
# RESEND_FROM_EMAIL=Client Growth <auth@your-verified-domain.example>

# --- AI (opt-in) ---
AI_PROVIDER=mock
# DEEPSEEK_API_KEY=sk-...
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat
MAX_AI_CALLS_PER_RUN=10
