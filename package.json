{
  "name": "client-growth",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "react-router build && wrangler dev",
    "build": "react-router build",
    "typecheck": "react-router typegen && tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval:live": "vitest run --config vitest.live.config.ts",
    "seed:generate": "tsx scripts/generate-seed.ts",
    "db:migrate:local": "wrangler d1 migrations apply client-growth-dev --local",
    "db:seed:local": "wrangler d1 execute client-growth-dev --local --file=./scripts/seed.sql",
    "production:preflight": "tsx scripts/production-preflight.ts",
    "db:migrations:production": "pnpm production:preflight && wrangler d1 migrations list client-growth-production --env production --remote",
    "db:migrate:production": "pnpm production:preflight && wrangler d1 migrations apply client-growth-production --env production --remote",
    "deploy:production": "pnpm production:preflight && pnpm typecheck && pnpm build && wrangler deploy --env production --experimental-provision=false --experimental-auto-create=false",
    "preview": "wrangler dev"
  },
  "dependencies": {
    "better-auth": "1.7.2",
    "isbot": "^5.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^7.18.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.2",
    "@cloudflare/workers-types": "^5.20260830.1",
    "@react-router/dev": "^7.18.3",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "better-sqlite3": "^11.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3",
    "vite": "^7.0.0",
    "vitest": "^3.2.7",
    "wrangler": "^4.127.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd",
      "@cloudflare/workerd-windows-64",
      "@cloudflare/workerd-linux-64",
      "@cloudflare/workerd-darwin-64",
      "@cloudflare/workerd-darwin-arm64",
      "@cloudflare/workerd-linux-arm64",
      "better-sqlite3"
    ]
  }
}
